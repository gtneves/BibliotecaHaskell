cabal-version: 2.4
name: library-manager
version: 0.1.0.0
build-type: Simple

executable library-manager
    main-is: Main.hs
    hs-source-dirs: app, src
    default-language: Haskell2010
    ghc-options: -Wall

    build-depends:
        base >=4.14 && <5,
        scotty,
        text,
        bytestring,
        sqlite-simple,
        aeson,
        blaze-html
    
    other-modules:
        Livro
        LivroController
        Database